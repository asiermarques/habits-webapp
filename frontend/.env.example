# Frontend config is build-time (baked at `vite build`). This file is the local
# dev template; in the production Docker image these are passed as build args
# (see Dockerfile), so they are NOT runtime env vars on the host / Railway.

# Backend API base URL. In dev the SPA (:5173) and API (:3001) are separate
# origins, so this is absolute. The Docker image builds it as "" (relative,
# same-origin) since Express serves the SPA there.
VITE_API_URL=http://localhost:3001

# Minutes a gated instance stays readable offline after the last online unlock
# (see frontend/src/gate/GateGuard.tsx). Optional; defaults to 120 (2h).
# GATE_OFFLINE_GRACE_MINUTES=120
