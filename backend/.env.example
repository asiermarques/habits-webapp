PORT=3001
DATABASE_URL=./habits.db
CORS_ORIGIN=http://localhost:5173
# FRONTEND_DIST_DIR=/path/to/frontend/dist  # production only; defaults to ../../frontend/dist relative to the compiled backend

# Instance password gate (optional — for public deployments). Leave both unset
# for a fully-open instance (local dev / tests). When GATE_PASSWORD is set,
# SESSION_SECRET is required or the server refuses to start.
# GATE_PASSWORD=change-me
# SESSION_SECRET=a-long-random-string

# Observability / telemetry (optional — see docs/OBSERVABILITY.md). Fail-open:
# leave the OTLP endpoint unset for a telemetry-free instance (local dev / tests).
# Setting an OTLP endpoint turns it on; export goes to a managed OTLP backend.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example-vendor.com
# OTEL_EXPORTER_OTLP_HEADERS=api-key=change-me   # secret — never commit a real key
# OTEL_SERVICE_NAME=habits-backend
